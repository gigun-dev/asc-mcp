{
  "name": "asc-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs distribution/worker.test.mjs",
    "check": "npm test && wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "test:python": "python3 -m unittest discover -s tests -p '*_test.py' && python3 distribution/publish.test.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@hono/mcp": "0.3.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
